{
  "permissions": {
    "allow": [
      "Bash(node tools/playtest/pt.mjs:*)",
      "Read(tools/playtest/runs/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/scene-signoff/console.mjs --line",
            "timeout": 30,
            "statusMessage": "Checking the Sign-Off board…"
          },
          {
            "type": "command",
            "command": "node tools/module-sync/deploy-status.mjs",
            "timeout": 30,
            "statusMessage": "Checking whether the Foundry server is behind…"
          },
          {
            "type": "command",
            "command": "node tools/module-sync/autosync.mjs start",
            "timeout": 30,
            "statusMessage": "Starting the auto-sync watcher…"
          },
          {
            "type": "command",
            "command": "node tools/scene-edits/session-start.mjs",
            "timeout": 40,
            "statusMessage": "Bringing Ingram's scene edits home from the server…"
          },
          {
            "type": "command",
            "command": "node tools/haunts/pull.mjs --line",
            "timeout": 30,
            "statusMessage": "Bringing the haunts' regulars home from the server…"
          },
          {
            "type": "command",
            "command": "node tools/objectives/pull.mjs --line",
            "timeout": 30,
            "statusMessage": "Bringing the objectives home from the server…"
          },
          {
            "type": "command",
            "command": "node tools/story/session-start.mjs",
            "timeout": 30,
            "statusMessage": "Reading Ingram's edits and notes on the plot timeline…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/scene-edits/pre-edit.mjs",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node tools/story/pre-edit.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
