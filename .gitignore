.DS_Store
Thumbs.db
node_modules/
*.log
# ...except captured tool output kept as test fixtures. These are REAL ffmpeg
# output, committed on purpose so the parsers are tested against what the tool
# actually prints rather than what we remember it printing.
!test/**/fixtures/*.log
.env
__pycache__/
*.pyc

# SSH/private keys — never committed, regardless of where they land locally.
*.ppk
*.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Large local reference trees — not project content, not for version control
/gamesystems/
/foundryvtt/
/reference/

# Raw asset intake libraries (images, audio) — large binaries, the user's own
# working source material. Organized/approved assets eventually get copied
# into foundry/blank-inheritance/assets/ for actual module use; these
# raw trees are never themselves version-controlled.
/artwork/
/audio/

# Third-party source material (someone else's licensed work, not ours to
# redistribute raw) — same "bulk material, not project content" treatment as
# gamesystems/foundryvtt/reference/artwork above, and the same shape as
# tools/font-pipeline/.cache/: only the specific frames/crops we actually use,
# processed into our own module assets, get committed. CREDITS.md (tracked)
# is the ledger of what lives here, who made it, and under what license.
/third-party/

# The old Foundry worlds (2026-09-24; see the old-server-data memory note). Mostly Paizo's published
# Abomination Vaults module, so the same treatment as third-party/: kept locally, never committed.
# What the campaign uses from them is transcribed into ideas/story/source-material/, which is tracked.
/old server data/

# Module binaries: synced to the Foundry server by WinSCP, but not committed.
# The .gitkeep files are kept so the directory structure survives in git.
/foundry/blank-inheritance/assets/**
!/foundry/blank-inheritance/assets/**/
!/foundry/blank-inheritance/assets/**/.gitkeep

# Battle-simulator generated output. All of this is reproducible from source at
# any time (`node tools/battle-simulator/run-scenario.mjs` then
# `node tools/battle-simulator/artifact/build.mjs`), and it is rewritten on every
# build — committing it would put ~1.2MB of churn into history per rebuild.
# assets/battle-map.b64.txt is deliberately NOT ignored: it has no generator
# script, is an input to build.mjs, and never changes.
/tools/battle-simulator/battle-log.json
/tools/battle-simulator/artifact/contact-simulation.html
/tools/battle-simulator/logs/

# Map-generator output. Fully reproducible from a seed at any time
# (`node tools/map-generator/cli.mjs --seed N --out out/coast-N`), and each SVG
# carries a ~500KB embedded relief raster — committing them would put megabytes
# of churn into history for something a one-line command regenerates exactly.
/tools/map-generator/out/

# City-map hand-touch-up layers: multi-gigabyte Photoshop source files (.psd/.psb),
# the user's own raw working material, never meant for version control. Caught
# 2026-09-16 after one accidentally landed in a commit and bloated .git by ~3GB.
/tools/city-map/export/layers/

# city-map's fetch/build cache: cached Overpass JSON and GSI DEM tiles (L0),
# parsed world models (L1), per-frame terrain fields (L2), and replayed
# worlds keyed by op-log content hash (L3). Large binary data reproducible
# from source at any time; same bulk-tree treatment as reference/, artwork/,
# audio/ above.
/tools/city-map/cache/

# Map editor: raw submitted JSON (my own working input, processed by hand
# into real ops -- see the map editor plan) and rendered PNGs served back
# to the browser. Both reproducible/regenerable, not project content.
/data/map/editor-submissions/
/tools/city-map/editor/renders/

# Map editor frontend (Phase 3 onward): Vite's build output, rebuilt from
# source at any time via `npm run build`.
/tools/city-map/frontend/dist/

# Scratch debug output from ad-hoc dev-session checks (before/after renders,
# candidate-site previews, one-off CLI logs) — not a real, reproducible build
# artifact with its own generator script the way the entries above are, just
# working scratch that accumulated in-tree. Never meant to be committed.
/tools/city-map/_out/

# Same shape as the above, but landed at the repo root instead of a tool's
# own scratch dir — a one-off CLI run that didn't cd first. Caught 2026-09-16.
/production-preview-1200.png
/region_buildings.json
/residential_candidates.json
/residential_picks.json

# Font pipeline download cache — full upstream TTFs (tens of MB) used only as
# subsetting input. The shipped woff2 files in module/.../assets/fonts/ ARE
# committed; these intermediates are reproducible via build_fonts.py.
tools/font-pipeline/.cache/

# Campaign JSON staged into the module for LOCAL Foundry testing.
# The source of truth is repo-root data/; tools/module-sync/stage-campaign-data.mjs
# builds this same tree into a temp dir on a real push, so a committed copy here
# would be a second source of truth that silently drifts.
module/blank-inheritance/data/campaign/

# Runtime session logs written by the module inside a live Foundry Data dir.
# module.json declares persistentStorage, so Foundry owns this directory;
# harvesting a session into the repo is a separate, deliberate step.
module/blank-inheritance/storage/

# Artwork staged into the module by tools/stage-assets/. Derived from
# artwork/in-tray/, which is itself gitignored; module-sync pushes from disk
# rather than from git, so the server still gets them. Regenerate with
# python tools/stage-assets/stage_assets.py
module/blank-inheritance/assets/stage/

# Dynamic Token Ring subject textures, circle-cropped from data/campaign/
# asset-registry.json's confirmed character-portrait assignments by
# tools/token-ring/. Same reasoning as assets/stage/ above -- derived,
# regenerable, pushed to the server from disk. Regenerate with
# python tools/token-ring/crop_ring_subject.py
module/blank-inheritance/assets/tokens/

# Harvested from the live server by tools/module-sync/sync-harvest.mjs.
# The session logs ARE kept -- they are the record of what actually happened
# at the table, and the whole reason the harvest direction exists. The sync
# test reports are pure diagnostics, regenerated on every run, and are not.
harvest/test-reports/

# What this machine last deployed (tools/module-sync/deploy.mjs), read by
# deploy-status.mjs at session start. A per-machine record, not content; the
# server's own data/campaign/build.json stays the truth.
tools/module-sync/.last-deploy.json

# tools/module-sync/review-harvest.mjs's own output -- a reproducible
# summary derived FROM harvest/sessions/ and harvest/chat-*.json, same
# "regenerate on demand" category as test-reports/ above, not a second copy
# of source data worth tracking.
harvest/inference/

# Scene edits (design/scene-edits.md): harvest/scene-edits/*.json -- every edit
# Ingram makes in the Scene Runner, pulled home -- IS tracked; it is the record
# of her changes. The merge lock and this machine's "last pulled" note are not.
harvest/scene-edits/.merge.lock
tools/scene-edits/.state.json

# location-sync (design/location-editor.md; retired tools/gazetteer/'s own
# geometry core, moved here 2026-09-29): calibration overlays and crops are
# regenerable working images, not project content. Same treatment as
# tools/city-map/_out/.
/tools/location-sync/_calibration/
/tools/location-sync/map-production/_calibration/
# Land/water mask and overlay renders, all derived from the gitignored
# master PNG. Regenerate with tools/location-sync/landmask.py.
/tools/location-sync/_cache/

# The retired gazetteer's own draft-session storage and client log --
# nothing writes here any more (design/location-editor.md §3.4: the
# equivalent session now lives in the Foundry module's own storage/), kept
# only so any leftover local file from before the retirement stays ignored.
/tools/gazetteer/_client.log
/data/map/gazetteer-drafts/

# SQLite WAL-mode sidecar files. citymap.store.gpkg opens data/map/kurose.gpkg
# with journal_mode=WAL (a long feature-query read must never block a short
# write), which creates these next to the tracked .gpkg on first connection.
# Transient local state, not content -- the same tracked-database/untracked-
# journal split as a .git/index vs its .lock.
*.gpkg-wal
*.gpkg-shm

# Human drop-zone for raw incoming material (externally-revised files, pre-replacement
# backups). Same policy as artwork/in-tray and audio/in-tray: dropped here, not yet adopted.
data/intray/

# Sign-Off reports: the HTML is generated from reviews/<scene>.json by
# tools/scene-signoff/report.mjs -- the JSON is the source, the page is the build.
reviews/*.html

# The Casebook build output (tools/casebook/build.mjs); the source is tools/casebook/ and canon/
tools/casebook/out/

# Stagecraft lab screenshots: they show Ingram's portrait and place art, which is never committed.
/design/stagecraft/lab/shots/

# Stagecraft: the dev build's source map is for working only; the shipped bundle (dist/stagecraft.js) is committed
/module/stagecraft/dist/*.map
