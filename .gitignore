.DS_Store
Thumbs.db
node_modules/
*.log
.env
__pycache__/
*.pyc

# SSH/private keys — never committed, regardless of where they land locally.
*.ppk
*.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Large local reference trees — not project content, not for version control
/gamesystems/
/foundryvtt/
/reference/

# Raw asset intake libraries (images, audio) — large binaries, the user's own
# working source material. Organized/approved assets eventually get copied
# into foundry/blank-inheritance/assets/ for actual module use; these
# raw trees are never themselves version-controlled.
/artwork/
/audio/

# Module binaries: synced to the Foundry server by WinSCP, but not committed.
# The .gitkeep files are kept so the directory structure survives in git.
/foundry/blank-inheritance/assets/**
!/foundry/blank-inheritance/assets/**/
!/foundry/blank-inheritance/assets/**/.gitkeep

# Battle-simulator generated output. All of this is reproducible from source at
# any time (`node tools/battle-simulator/run-scenario.mjs` then
# `node tools/battle-simulator/artifact/build.mjs`), and it is rewritten on every
# build — committing it would put ~1.2MB of churn into history per rebuild.
# assets/battle-map.b64.txt is deliberately NOT ignored: it has no generator
# script, is an input to build.mjs, and never changes.
/tools/battle-simulator/battle-log.json
/tools/battle-simulator/artifact/contact-simulation.html
/tools/battle-simulator/logs/

# Map-generator output. Fully reproducible from a seed at any time
# (`node tools/map-generator/cli.mjs --seed N --out out/coast-N`), and each SVG
# carries a ~500KB embedded relief raster — committing them would put megabytes
# of churn into history for something a one-line command regenerates exactly.
/tools/map-generator/out/

# city-map's fetch/build cache: cached Overpass JSON and GSI DEM tiles (L0),
# parsed world models (L1), per-frame terrain fields (L2), and replayed
# worlds keyed by op-log content hash (L3). Large binary data reproducible
# from source at any time; same bulk-tree treatment as reference/, artwork/,
# audio/ above.
/tools/city-map/cache/

# Map editor: raw submitted JSON (my own working input, processed by hand
# into real ops -- see the map editor plan) and rendered PNGs served back
# to the browser. Both reproducible/regenerable, not project content.
/data/map/editor-submissions/
/tools/city-map/editor/renders/

# Map editor frontend (Phase 3 onward): Vite's build output, rebuilt from
# source at any time via `npm run build`.
/tools/city-map/frontend/dist/

# Scratch debug output from ad-hoc dev-session checks (before/after renders,
# candidate-site previews, one-off CLI logs) — not a real, reproducible build
# artifact with its own generator script the way the entries above are, just
# working scratch that accumulated in-tree. Never meant to be committed.
/tools/city-map/_out/

# Font pipeline download cache — full upstream TTFs (tens of MB) used only as
# subsetting input. The shipped woff2 files in module/.../assets/fonts/ ARE
# committed; these intermediates are reproducible via build_fonts.py.
tools/font-pipeline/.cache/

# Campaign JSON staged into the module for LOCAL Foundry testing.
# The source of truth is repo-root data/; tools/module-sync/stage-campaign-data.mjs
# builds this same tree into a temp dir on a real push, so a committed copy here
# would be a second source of truth that silently drifts.
module/blank-inheritance/data/campaign/

# Runtime session logs written by the module inside a live Foundry Data dir.
# module.json declares persistentStorage, so Foundry owns this directory;
# harvesting a session into the repo is a separate, deliberate step.
module/blank-inheritance/storage/

# Artwork staged into the module by tools/stage-assets/. Derived from
# artwork/in-tray/, which is itself gitignored; module-sync pushes from disk
# rather than from git, so the server still gets them. Regenerate with
# python tools/stage-assets/stage_assets.py
module/blank-inheritance/assets/stage/

# Harvested from the live server by tools/module-sync/sync-harvest.mjs.
# The session logs ARE kept -- they are the record of what actually happened
# at the table, and the whole reason the harvest direction exists. The sync
# test reports are pure diagnostics, regenerated on every run, and are not.
harvest/test-reports/

# Gazetteer: calibration overlays and crops are regenerable working images,
# not project content. Same treatment as tools/city-map/_out/.
/tools/gazetteer/_calibration/
/tools/gazetteer/_tiles/

# Drawing-session drafts: raw input awaiting hand-conversion into real location
# entities, exactly like data/map/editor-submissions/ before them.
/data/map/gazetteer-drafts/

# SQLite WAL-mode sidecar files. citymap.store.gpkg opens data/map/kurose.gpkg
# with journal_mode=WAL (a long feature-query read must never block a short
# write), which creates these next to the tracked .gpkg on first connection.
# Transient local state, not content -- the same tracked-database/untracked-
# journal split as a .git/index vs its .lock.
*.gpkg-wal
*.gpkg-shm
