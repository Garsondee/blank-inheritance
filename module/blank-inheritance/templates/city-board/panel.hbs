{{!--
    The city board — button and panel are ONE chassis (this file's single
    root), same discipline as phone.hbs: a re-render can never leave them
    disagreeing about open/closed.

    GM-only (foundry/city-board.mjs never mounts this for a player), and DEMO
    DATA throughout — see that file's own header and
    ideas/entries/city-map-location-board.json for why.
--}}
<div class="bi-city-board-standalone">
    <button type="button" class="bi-city-board-btn" data-action="toggle" aria-pressed="{{open}}"
        aria-label="{{localize 'BLANKINHERITANCE.CityBoard.Toggle'}}" data-tooltip="{{localize 'BLANKINHERITANCE.CityBoard.Toggle'}}">
        <i class="fa-solid fa-map-location-dot bi-city-board-btn__glyph"></i>
    </button>

    <div class="bi-terminal{{#if open}} bi-terminal--open{{/if}}">
        <div class="bi-terminal__frame">
            <div class="bi-terminal__titlebar">
                <span class="bi-terminal__title-glyph"><i class="fa-solid fa-map-location-dot"></i></span>
                <span class="bi-terminal__title">{{localize "BLANKINHERITANCE.CityBoard.Title"}}</span>
                <span class="bi-terminal__demo-flag">{{localize "BLANKINHERITANCE.CityBoard.DemoFlag"}}</span>
                <span class="bi-terminal__spacer"></span>
                <button type="button" class="bi-terminal__close" data-action="toggle" aria-label="{{localize 'BLANKINHERITANCE.Console.Window.Close'}}">&times;</button>
            </div>
            <div class="bi-terminal__body bi-terminal__body--board">
                <div class="bi-console__scene bi-city-board__scene" style="width:{{boardWidth}}px;height:{{boardHeight}}px">
                    {{#each markers}}
                    <article class="bi-marker{{#if this.isOk}} bi-marker--ok{{/if}}{{#if this.isWarn}} bi-marker--warn{{/if}}{{#if this.isDanger}} bi-marker--danger{{/if}}{{#if this.isSelected}} bi-marker--selected{{/if}}"
                        data-marker="{{this.id}}" style="--x:{{this.x}};--y:{{this.y}};--dx:{{this.dx}}px;--dy:{{this.dy}}px">
                        <button type="button" class="bi-marker__dot" data-action="selectMarker"
                            aria-label="{{localize 'BLANKINHERITANCE.CityBoard.Target'}} {{this.name}}" aria-pressed="{{this.isSelected}}"></button>
                        <span class="bi-marker__stem" aria-hidden="true"></span>
                        <span class="bi-marker__shadow" aria-hidden="true"></span>
                        <div class="bi-marker__card bi-plate-skin">
                            <header class="bi-marker__head">
                                <span class="bi-plate bi-plate--brass bi-marker__code">{{this.code}}</span>
                                <span class="bi-plate bi-marker__name" title="{{this.name}}">{{this.name}}</span>
                                <span class="bi-lamp bi-lamp--lit bi-marker__lamp"></span>
                            </header>
                            <div class="bi-marker__risk bi-screen" data-risk="{{this.risk}}" aria-label="{{localize 'BLANKINHERITANCE.CityBoard.Risk'}} {{this.risk}}">
                                <span class="bi-legend">{{localize "BLANKINHERITANCE.CityBoard.Status"}}</span>
                                <span class="bi-marker__gauge" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                                <span class="bi-marker__band">{{this.status}}</span>
                                <span class="bi-marker__detail">{{this.detail}}</span>
                            </div>
                        </div>
                    </article>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>
