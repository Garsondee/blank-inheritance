{{!--
    The deck's right side: inner then outer, the mirror of track-left.hbs.
    See that file for why material lives in CSS rather than here.
--}}
<div class="bi-deck__side bi-deck__side--right" data-track="right">
    {{#each tracks.right.zones}}
    <section class="bi-deck__module" data-slot="{{this.slot}}" data-zone="{{this.id}}" data-partial="{{this.partial}}"
        aria-label="{{localize this.labelKey}}" {{#if this.hidden}}hidden{{/if}}>
        {{#if this.template}}{{> (lookup this 'template')}}{{/if}}
    </section>
    {{/each}}
</div>
