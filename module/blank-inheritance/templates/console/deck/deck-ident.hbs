{{!--
    The player's left shoulder: who I am, in one glance. A silver module after
    the north star's shoulder panels — an engraved header, then a recessed
    well — with the ways off the deck as pill keys.

    Deliberately glance-scale (ux-doctrine Law 13): the full sheet is one pill
    away, so nothing here is a list. Conditions are capped by the adapter and
    the overflow counted, never scrolled.

    2026-09-23: widened with the deck. The well gained Perception DC (what a
    GM asks for when someone tries to sneak past), focus points beside hero
    points, and the wounded count once there is one; the pills go straight to
    the Console's Spells and Gear tabs (one press, not open-then-find), and
    Spells is dark for a character with nothing to cast.
--}}
<div class="bi-deck-shoulder bi-deck-ident">
    <div class="bi-deck-shoulder__head">
        <span class="bi-deck__grille bi-deck__grille--mini" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="bi-deck__engraved">{{localize "BLANKINHERITANCE.Deck.Dossier"}}</span>
    </div>
    {{#if ident}}
    <div class="bi-deck__well bi-deck-ident__well">
        <div class="bi-deck-ident__who">
            <span class="bi-deck-ident__portrait">{{#if ident.img}}<img src="{{ident.img}}" alt="">{{/if}}</span>
            <span class="bi-deck-ident__text">
                <span class="bi-deck-ident__name">{{ident.name}}</span>
                <span class="bi-deck-ident__line">{{ident.line}}</span>
            </span>
        </div>
        <div class="bi-deck-ident__row">
            <span class="bi-deck__chip" data-preview-title="{{localize 'BLANKINHERITANCE.Deck.ArmorClass'}}" data-preview-value="{{ident.ac}}" data-preview-sub="{{ident.acBreakdown}}">
                <em>{{localize "BLANKINHERITANCE.Deck.AC"}}</em><b>{{ident.ac}}</b>
            </span>
            <span class="bi-deck__chip" data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Speed'}}" data-preview-value="{{ident.speed}}" data-preview-sub="{{ident.speedSub}}">
                <em>{{localize "BLANKINHERITANCE.Deck.Spd"}}</em><b>{{ident.speed}}</b>
            </span>
            {{#if ident.perceptionDc}}
            <span class="bi-deck__chip" data-preview-title="{{localize 'BLANKINHERITANCE.Deck.PerceptionDC'}}" data-preview-value="{{ident.perceptionDc}}" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.PerceptionDCSub'}}">
                <em>{{localize "BLANKINHERITANCE.Deck.PerDC"}}</em><b>{{ident.perceptionDc}}</b>
            </span>
            {{/if}}
        </div>
        <div class="bi-deck-ident__row">
            <span class="bi-deck-ident__lamps" data-preview-title="{{localize 'BLANKINHERITANCE.Deck.HeroPoints'}}" data-preview-value="{{ident.heroLabel}}" data-preview-sub="">
                <em>{{localize "BLANKINHERITANCE.Deck.Hero"}}</em>
                {{#each ident.hero}}<i class="bi-deck__jewel{{#if this}} is-lit{{/if}}"></i>{{/each}}
            </span>
            {{#if ident.focusLabel}}
            <span class="bi-deck-ident__lamps" data-preview-title="{{localize 'BLANKINHERITANCE.Deck.FocusPoints'}}" data-preview-value="{{ident.focusLabel}}" data-preview-sub="">
                <em>{{localize "BLANKINHERITANCE.Deck.Focus"}}</em>
                {{#each ident.focus}}<i class="bi-deck__jewel bi-deck__jewel--cool{{#if this}} is-lit{{/if}}"></i>{{/each}}
            </span>
            {{/if}}
            {{#if ident.wounded}}
            <span class="bi-deck__tag" data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Wounded'}}" data-preview-value="{{ident.wounded}}" data-preview-sub="">{{localize "BLANKINHERITANCE.Deck.Wounded"}} {{ident.wounded}}</span>
            {{/if}}
        </div>
        <div class="bi-deck-ident__conditions">
            {{#each ident.conditions}}
            <span class="bi-deck__tag">{{this.label}}{{#if this.value}} {{this.value}}{{/if}}</span>
            {{else}}
            <span class="bi-deck__tag bi-deck__tag--quiet">{{localize "BLANKINHERITANCE.Deck.NoConditions"}}</span>
            {{/each}}
            {{#if ident.moreConditions}}<span class="bi-deck__tag bi-deck__tag--more">+{{ident.moreConditions}}</span>{{/if}}
        </div>
    </div>
    {{else}}
    <div class="bi-deck__well bi-deck-ident__well bi-deck-ident__well--empty">
        <span class="bi-deck__plate">{{localize "BLANKINHERITANCE.Deck.NoCharacter"}}</span>
    </div>
    {{/if}}
    <div class="bi-deck__pills bi-deck__pills--tight">
        <span class="bi-deck-pill">
            <button type="button" class="bi-deck-pill__cap" data-action="openSheet" aria-label="{{localize 'BLANKINHERITANCE.Deck.Sheet'}}"
                data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Sheet'}}" data-preview-value="" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.SheetSub'}}"></button>
            <span class="bi-deck-pill__label">{{localize "BLANKINHERITANCE.Deck.Sheet"}}</span>
        </span>
        <span class="bi-deck-pill">
            <button type="button" class="bi-deck-pill__cap" data-action="openConsoleTab" data-tab="spells" {{#unless ident.hasSpells}}disabled{{/unless}}
                aria-label="{{localize 'BLANKINHERITANCE.Deck.Spells'}}"
                data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Spells'}}" data-preview-value="" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.SpellsSub'}}"></button>
            <span class="bi-deck-pill__label">{{localize "BLANKINHERITANCE.Deck.Spells"}}</span>
        </span>
        <span class="bi-deck-pill">
            <button type="button" class="bi-deck-pill__cap" data-action="openConsoleTab" data-tab="gear" {{#unless ident}}disabled{{/unless}}
                aria-label="{{localize 'BLANKINHERITANCE.Deck.Gear'}}"
                data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Gear'}}" data-preview-value="" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.GearSub'}}"></button>
            <span class="bi-deck-pill__label">{{localize "BLANKINHERITANCE.Deck.Gear"}}</span>
        </span>
        <span class="bi-deck-pill">
            <button type="button" class="bi-deck-pill__cap" data-action="openNotebook" aria-label="{{localize 'BLANKINHERITANCE.Deck.Notes'}}"
                data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Notes'}}" data-preview-value="N" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.NotesSub'}}"></button>
            <span class="bi-deck-pill__label">{{localize "BLANKINHERITANCE.Deck.Notes"}}</span>
        </span>
        <span class="bi-deck-pill">
            <button type="button" class="bi-deck-pill__cap" data-action="openJournal" aria-label="{{localize 'BLANKINHERITANCE.Deck.Journal'}}"
                data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Journal'}}" data-preview-value="J" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.JournalSub'}}"></button>
            <span class="bi-deck-pill__label">{{localize "BLANKINHERITANCE.Deck.Journal"}}</span>
        </span>
        <span class="bi-deck-pill">
            <button type="button" class="bi-deck-pill__cap" data-action="openComms" aria-label="{{localize 'BLANKINHERITANCE.Deck.Comms'}}"
                data-preview-title="{{localize 'BLANKINHERITANCE.Deck.Comms'}}" data-preview-value="" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.CommsSub'}}"></button>
            <span class="bi-deck-pill__label">{{localize "BLANKINHERITANCE.Deck.Comms"}}</span>
        </span>
    </div>
</div>
