{{!--
    One of the deck's two black key banks — nine skills, three by three.
    core/deck-layout.mjs#splitChecks deals A–M to the left bank and N–T to the
    right and pads both to nine, so a creature with fewer skills shows blank
    caps in the same places instead of a bank that changes shape per token.

    Each key (D063) is a wide cap: a recessed nameplate across its top with the
    skill's whole name, and below it the number that will actually be rolled
    (ux-doctrine Law 1) beside its proficiency pips, between two ribbed grips.
    The plate's wash and the grips are in the colour of the attribute the skill
    adds, which is the only grouping there is: the keys stay in alphabetical
    order. Its data-preview-* attributes are what the central instrument reads
    out while a hand is on it — no Foundry call on hover.
--}}
<div class="bi-deck-bank" data-side="{{bank.side}}">
    <div class="bi-deck__cell bi-deck-bank__cell">
        <span class="bi-deck__legend">{{localize "BLANKINHERITANCE.Deck.Skills"}}</span>
        <div class="bi-deck-bank__keys">
            {{#each bank.keys}}
            {{#if this}}
            {{#if this.ask}}
            <button type="button" class="bi-deck-key bi-deck-key--ask" data-attribute="{{this.attribute}}" data-action="rollCheck" data-slug="{{this.slug}}" data-label="{{this.label}}"
                aria-label="{{localize 'BLANKINHERITANCE.Deck.Ask'}} {{this.label}}"
                data-preview-title="{{this.label}}" data-preview-value="{{localize 'BLANKINHERITANCE.Deck.Ask'}}" data-preview-sub="{{localize 'BLANKINHERITANCE.Deck.AskTheTableSub'}}">
                <span class="bi-deck-key__plate"><span class="bi-deck-key__label">{{this.label}}</span></span>
                <span class="bi-deck-key__read"><span class="bi-deck-key__ask">{{localize "BLANKINHERITANCE.Deck.Ask"}}</span></span>
            </button>
            {{else}}
            <button type="button" class="bi-deck-key" data-attribute="{{this.attribute}}" data-action="rollCheck" data-slug="{{this.slug}}" data-label="{{this.label}}"
                data-rank="{{this.rank}}" aria-label="{{this.label}} {{this.modLabel}}"
                data-preview-title="{{this.label}}" data-preview-value="{{this.modLabel}}" data-preview-sub="{{this.previewSub}}">
                <span class="bi-deck-key__plate"><span class="bi-deck-key__label">{{this.label}}</span></span>
                <span class="bi-deck-key__read">
                    <span class="bi-deck-key__mod">{{this.modLabel}}</span>
                    <span class="bi-deck-key__pips" aria-hidden="true">{{#each this.dots}}<i{{#if this}} class="is-lit"{{/if}}></i>{{/each}}</span>
                </span>
            </button>
            {{/if}}
            {{else}}
            <span class="bi-deck-key bi-deck-key--blank" aria-hidden="true"><span class="bi-deck-key__plate"></span></span>
            {{/if}}
            {{/each}}
        </div>
    </div>
</div>
