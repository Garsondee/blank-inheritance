{{!--
    Left track of the command bar: identity. Who am I, what shape am I in.

    Must render exactly ONE top-level element — ApplicationV2's #parsePartHTML
    throws "Template part must render a single HTML element" otherwise
    (client/applications/api/handlebars-application.mjs). The data-application-part
    attribute is added by Foundry, not here.
--}}
<div class="bi-bar__group bi-bar__group--left" data-track="left" {{#if tracks.left.hidden}}hidden{{/if}}>
    {{#each tracks.left.zones}}
    <section class="bi-pod" data-zone="{{this.id}}" data-partial="{{this.partial}}" {{#if this.hidden}}hidden{{/if}}>
        <h2 class="bi-legend">{{localize this.labelKey}}</h2>
        {{#if this.template}}{{> (lookup this 'template')}}{{/if}}
    </section>
    {{/each}}
</div>
