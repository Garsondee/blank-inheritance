{{!--
    The deck's left side: two modules, outer then inner (core/console-model.mjs
    orders them physically). The module's face is its zone partial; the
    material (silver shoulder vs black key bank) comes from data-slot in CSS,
    so a template never decides what a module is made of.

    Must render exactly ONE top-level element — ApplicationV2's #parsePartHTML
    throws otherwise (tier0-architecture.test.mjs enforces it).
--}}
<div class="bi-deck__side bi-deck__side--left" data-track="left">
    {{#each tracks.left.zones}}
    <section class="bi-deck__module" data-slot="{{this.slot}}" data-zone="{{this.id}}" data-partial="{{this.partial}}"
        aria-label="{{localize this.labelKey}}" {{#if this.hidden}}hidden{{/if}}>
        {{#if this.template}}{{> (lookup this 'template')}}{{/if}}
    </section>
    {{/each}}
</div>
