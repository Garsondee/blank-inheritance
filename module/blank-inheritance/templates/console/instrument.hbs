{{!--
    The deck's spine: the silver column carrying the central instrument. The
    instrument itself rises above the faceplate's top edge — the one part of
    the deck that breaks its own line, on purpose.
--}}
<div class="bi-deck__spine" data-track="instrument">
    {{#each tracks.instrument.zones}}
    <section class="bi-deck__module" data-slot="{{this.slot}}" data-zone="{{this.id}}" data-partial="{{this.partial}}"
        aria-label="{{localize this.labelKey}}" {{#if this.hidden}}hidden{{/if}}>
        {{#if this.template}}{{> (lookup this 'template')}}{{/if}}
    </section>
    {{/each}}
</div>
