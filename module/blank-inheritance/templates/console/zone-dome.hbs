{{!--
    The day ring: the four quarters of the in-fiction day, and which one we
    are standing in.

    Theatre of the mind only. In a fight, time is rounds — core/console-model.mjs
    sheds this zone outside theatre, which is Ingram's own ruling and not a
    layout convenience.

    Every path in here is computed by core/day-ring.mjs#ringSlices against a
    100x100 viewBox, so the ring survives being resized by CSS without any
    coordinate in this file needing to change. Nothing here does arithmetic.
--}}
<div class="bi-ring" data-quarter="{{ring.quarter}}"{{#if ring.school}} data-school="1"{{/if}}>
    <svg class="bi-ring__dial" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        {{#each ring.slices}}
        <path class="bi-ring__slice" d="{{this.d}}" data-state="{{this.state}}"
            data-quarter="{{this.id}}"{{#if this.school}} data-school="1"{{/if}}></path>
        {{/each}}
    </svg>
    <div class="bi-ring__readout">
        <span class="bi-ring__day">{{localize "BLANKINHERITANCE.Console.Ring.Day" day=ring.day}}</span>
        <span class="bi-ring__quarter">{{localize ring.quarterLabelKey}}</span>
    </div>
    {{#if canAdvance}}
    <button type="button" class="bi-ring__advance" data-action="advanceSegment"
        title="{{localize "BLANKINHERITANCE.Console.Ring.Advance"}}"
        aria-label="{{localize "BLANKINHERITANCE.Console.Ring.Advance"}}">&#9654;</button>
    {{/if}}
</div>
