{{!--
    The induction terminal — Page 5, Attribute Boosts.

    The four free ability boosts every character gets at chargen (design/
    induction-terminal.md §4) -- ancestry/background/class boosts from
    Pages 2-4 already apply automatically and aren't re-shown here (they're
    each already visible on their own page; repeating them would just be
    noise). Four identical, fully-open slots (core/induction-attributes.mjs)
    -- the SAME boost-slot machinery as Pages 2-4, its fourth real consumer.

    PAPER register throughout, same .bi-doc/.bi-induction__slots vocabulary
    as Pages 2-4. No picker/resolver two-state here -- nothing to browse or
    search, just four choices to make.
--}}
<section class="bi-induction">
    <div class="bi-doc bi-induction__page">
        <header class="bi-doc__head">
            <h1 class="bi-doc__title"><span class="bi-doc__title-jp">{{localize "BLANKINHERITANCE.Induction.OrgNameJP"}}</span>{{localize "BLANKINHERITANCE.Induction.Page5.Title"}}</h1>
            <div class="bi-doc__meta">
                {{localize "BLANKINHERITANCE.Induction.Page5.FormNumber"}}
                {{#if userName}}<br><b>{{userName}}</b>{{/if}}
            </div>
        </header>

        <nav class="bi-induction__tracker" aria-label="{{localize 'BLANKINHERITANCE.Induction.Tracker.Label'}}">
            <ol class="bi-induction__tracker-steps">
                {{#each trackerSteps}}
                <li>
                    {{#if this.canJump}}
                    <button type="button" class="bi-induction__tracker-step {{#if this.isDone}}bi-induction__tracker-step--done{{/if}} bi-induction__tracker-step--link"
                            data-action="jumpToStep" data-step="{{this.id}}" title="{{this.number}}. {{this.label}}" aria-label="{{this.number}}. {{this.label}}">{{this.number}}</button>
                    {{else}}
                    <span class="bi-induction__tracker-step {{#if this.isDone}}bi-induction__tracker-step--done{{/if}} {{#if this.isCurrent}}bi-induction__tracker-step--current{{/if}}"
                          title="{{this.number}}. {{this.label}}" {{#if this.isCurrent}}aria-current="step"{{/if}}>{{this.number}}</span>
                    {{/if}}
                </li>
                {{/each}}
            </ol>
            <span class="bi-induction__tracker-label">{{trackerLabel}}</span>
        </nav>
        <div class="bi-induction__body" data-induction-body>

        <p>{{localize "BLANKINHERITANCE.Induction.Page5.Intro"}}</p>

        <p class="bi-induction__tally-count" role="status">{{localize "BLANKINHERITANCE.Induction.Page5.Count" picked=freePickedCount}}</p>
        <div class="bi-induction__tally" role="group" aria-label="{{localize 'BLANKINHERITANCE.Induction.Page5.TallyLabel'}}">
            {{#each attributeRows}}
            <div class="bi-induction__tally-row {{#if this.picked}}bi-induction__tally-row--picked{{/if}}">
                <button type="button" class="bi-induction__option bi-induction__tally-toggle {{#if this.picked}}bi-induction__option--picked{{/if}}"
                        data-action="toggleFreeBoost" data-ability="{{this.ability}}"
                        aria-pressed="{{#if this.picked}}true{{else}}false{{/if}}" {{#if this.disabled}}disabled{{/if}}>{{this.label}}</button>
                <span class="bi-induction__tally-mod {{#if this.isRaised}}bi-induction__tally-mod--up{{/if}} {{#if this.isLowered}}bi-induction__tally-mod--down{{/if}}">{{this.modLabel}}</span>
                <span class="bi-induction__tally-parts">{{this.partsLabel}}</span>
            </div>
            {{/each}}
        </div>

        <details class="bi-induction__help" data-sync="help">
            <summary>{{localize "BLANKINHERITANCE.Induction.Page5.HelpSummary"}}</summary>
            <p>{{localize "BLANKINHERITANCE.Induction.Page5.HelpBody"}}</p>
        </details>

        </div>

        <div class="bi-induction__actions bi-induction__actions--split">
            <button type="button" class="bi-induction__back" data-action="backFromAttributes">{{localize "BLANKINHERITANCE.Induction.Page5.Back"}}</button>
            <span class="bi-induction__blocker" role="status" data-induction-blocker {{#unless blocker}}hidden{{/unless}}>{{blocker}}</span>
            {{#if canReturnToReview}}<button type="button" class="bi-induction__back bi-induction__to-review" data-action="returnToReview">{{localize "BLANKINHERITANCE.Induction.ReturnToReview"}}</button>{{/if}}
            <button type="button" class="bi-induction__begin" data-action="continueFromAttributes">
                {{localize "BLANKINHERITANCE.Induction.Page5.Continue"}}
            </button>
        </div>
    </div>
</section>
