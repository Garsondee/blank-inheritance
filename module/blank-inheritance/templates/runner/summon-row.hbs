{{!-- One summonable actor, as a card — redesigned 2026-09-19 (Ingram, live
      screenshot review: "the NPC gallery... needs a lot of work"). Portrait
      first and largest, since a face is the fastest thing a GM recognises
      mid-scene; name and status read as a caption underneath rather than
      competing with the portrait for one cramped row. --}}
<li class="bi-summon__card{{#if onStage}} bi-summon__card--onstage{{/if}}">
    <div class="bi-summon__portrait-well">
        <img class="bi-summon__portrait" src="{{img}}" alt="" />
        {{#if onStage}}<span class="bi-summon__onstage-badge">{{localize "BLANKINHERITANCE.Runner.Summon.OnStage"}}</span>{{/if}}
    </div>
    <span class="bi-summon__name">{{name}}</span>
    <span class="bi-summon__tag{{#if isPc}} bi-summon__tag--pc{{else}} bi-summon__tag--npc{{/if}}">
        {{#if isPc}}{{localize "BLANKINHERITANCE.Runner.Summon.Pc"}}{{else}}{{localize "BLANKINHERITANCE.Runner.Summon.Npc"}}{{/if}}
    </span>
    {{#if onStage}}
    <button type="button" class="bi-summon__action bi-summon__action--dismiss" data-action="dismissActor" data-actor-id="{{id}}">
        {{localize "BLANKINHERITANCE.Runner.Summon.Dismiss"}}
    </button>
    {{else}}
    <button type="button" class="bi-summon__action bi-summon__action--summon" data-action="summonActor" data-actor-id="{{id}}">
        {{localize "BLANKINHERITANCE.Runner.Summon.Summon"}}
    </button>
    {{/if}}
</li>
