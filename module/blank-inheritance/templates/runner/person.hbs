{{!--
    One person the GM might have to be.

    FOLDED: a face (or an initial), their name and role, the stage key, and
    what they WANT — the one line that decides what they do when the players
    go somewhere the script never anticipated, so it is never folded away.

    OPEN (the person the beat being run is about opens by themselves, and any
    card opens on a press of their name): how they open, how they talk, lines
    to steal, what they will and will not discuss, and what can be moved on,
    with its check. Ordered the way it is needed at the table: voice first,
    because the GM is about to speak as them.

    Rebuilt 2026-09-24. The old card was a <details> buried in a folded Cast
    section two screens below the beats, and the only stage control was a
    floating "put on stage" key with no way to take anyone off again.
--}}
<article class="bi-runner__person{{#if walkOn}} bi-runner__person--walkon{{/if}}{{#if inBeat}} bi-runner__person--inbeat{{/if}}{{#if isOpen}} bi-runner__person--open{{/if}}" data-cast-id="{{id}}">
    <div class="bi-runner__person-head">
        {{#if portrait}}<img class="bi-runner__person-portrait" src="{{portrait}}" alt="">{{else}}<span class="bi-runner__person-initial" aria-hidden="true">{{initial}}</span>{{/if}}
        <div class="bi-runner__person-id" data-action="togglePerson" data-cast-id="{{id}}" role="button" tabindex="0" aria-expanded="{{isOpen}}">
            <span class="bi-runner__person-name">{{displayName}}</span>
            {{#if role}}<span class="bi-runner__person-role">{{role}}</span>{{/if}}
            {{#if inBeat}}<span class="bi-runner__person-flag">{{localize "BLANKINHERITANCE.Runner.InThisBeat"}}</span>{{/if}}
        </div>
        {{!-- Straight onto the stage the table is looking at. Most of a
              brief's cast have no Actor at all, which is exactly the case the
              summon gallery cannot help with. The stage key is always here
              (the guided demo presses it by its data-portrait-id); once they
              are up, a second key takes them off again. --}}
        <div class="bi-runner__person-stage">
            <button type="button" class="bi-runner__stage{{#if onStage}} bi-runner__stage--on{{/if}}"
                data-action="stagePerson" data-portrait-id="{{portraitId}}"
                data-tooltip="{{#if onStage}}{{localize 'BLANKINHERITANCE.Runner.OnStage'}}{{else}}{{localize 'BLANKINHERITANCE.Runner.PutOnStage'}}{{/if}}">
                <i class="fa-solid fa-masks-theater"></i> {{#if onStage}}{{localize "BLANKINHERITANCE.Runner.IsOnStage"}}{{else}}{{localize "BLANKINHERITANCE.Runner.Stage"}}{{/if}}
            </button>
            {{#if onStage}}
            <button type="button" class="bi-runner__unstage" data-action="unstagePerson" data-portrait-id="{{portraitId}}"
                aria-label="{{localize 'BLANKINHERITANCE.Runner.TakeOff'}}" data-tooltip="{{localize 'BLANKINHERITANCE.Runner.TakeOff'}}">&times;</button>
            {{/if}}
            {{!-- Only someone the table calls something else ("the attendant")
                  has a real name to hold back. One press tells the table for
                  the rest of the campaign; shift-press also drops the banner.
                  Once told the key just says so. --}}
            {{#if nameProtected}}
            <button type="button" class="bi-runner__stage{{#if nameKnown}} bi-runner__stage--on{{/if}}"
                data-action="revealName" data-cast-id="{{id}}" {{#if nameKnown}}disabled{{/if}}
                data-tooltip="{{#if nameKnown}}{{localize 'BLANKINHERITANCE.Runner.NameTold'}}{{else}}{{localize 'BLANKINHERITANCE.Runner.TellName'}}{{/if}}">
                <i class="fa-solid fa-signature"></i> {{#if nameKnown}}{{localize "BLANKINHERITANCE.Runner.Named"}}{{else}}{{localize "BLANKINHERITANCE.Runner.Name"}}{{/if}}
            </button>
            {{/if}}
        </div>
    </div>

    {{#if brief.wants}}<p class="bi-runner__wants">{{brief.wants}}</p>{{/if}}

    {{#if isOpen}}
    <div class="bi-runner__person-body">
        {{#if brief.opensWith}}
        <p class="bi-runner__opens"><b>{{localize "BLANKINHERITANCE.Runner.Opens"}}</b> {{brief.opensWith}}</p>
        {{/if}}

        {{#if brief.voice.register}}<p class="bi-runner__voice">{{brief.voice.register}}</p>{{/if}}

        {{!-- Sample lines. A different face on purpose — this is the only
              text on the card you might actually say out loud, and it should
              not look like a note about the person. --}}
        {{#if brief.voice.samples.length}}
        <div class="bi-runner__samples">
            {{#each brief.voice.samples}}
            <p class="bi-runner__sample">{{this}}</p>
            {{/each}}
        </div>
        {{/if}}

        {{#if brief.willDiscuss.length}}
        <p class="bi-runner__topics-title">{{localize "BLANKINHERITANCE.Runner.Will"}}</p>
        <ul class="bi-runner__topics">
            {{#each brief.willDiscuss}}
            <li class="bi-runner__topic"><b>{{topic}}</b>{{#if note}} — <i>{{note}}</i>{{/if}}</li>
            {{/each}}
        </ul>
        {{/if}}

        {{#if brief.willNotDiscuss.length}}
        <p class="bi-runner__topics-title">{{localize "BLANKINHERITANCE.Runner.WillNot"}}</p>
        <ul class="bi-runner__topics">
            {{#each brief.willNotDiscuss}}
            <li class="bi-runner__topic bi-runner__topic--refused"><b>{{topic}}</b>{{#if why}} — <i>{{why}}</i>{{/if}}</li>
            {{/each}}
        </ul>
        {{/if}}

        {{#if brief.coercible.length}}
        <p class="bi-runner__topics-title">{{localize "BLANKINHERITANCE.Runner.Coercible"}}</p>
        <ul class="bi-runner__topics">
            {{#each brief.coercible}}
            <li class="bi-runner__topic">
                <b>{{topic}}</b>{{#if how}} — <i>{{how}}</i>{{/if}}
                {{!-- One-click DC-plus-degree-of-success recording per subject
                      (design/ux-doctrine.md §10.7's Cast drawer). Only a topic
                      authored with a challengeRef gets these -- #decorateCoercibleTopic
                      in scene-runner.mjs leaves everything else exactly as before. --}}
                {{#if check}}
                <div class="bi-runner__topic-check">
                    <button type="button" class="bi-runner__stamp" data-action="postTopicCheck"
                        data-cast-id="{{../id}}" data-topic-index="{{@index}}" title="{{check.title}}"><i class="fa-solid fa-dice-d20"></i> {{check.label}}</button>
                    {{#each outcomes}}
                    <button type="button" class="bi-runner__stamp{{#if isPicked}} bi-runner__stamp--picked{{/if}}"
                        data-action="recordTopicOutcome" data-cast-id="{{../../id}}" data-topic-index="{{@../index}}" data-degree="{{degree}}"
                        {{#if consequence}}data-tooltip="{{consequence}}"{{/if}}>{{label}}</button>
                    {{/each}}
                </div>
                {{/if}}
            </li>
            {{/each}}
        </ul>
        {{/if}}
    </div>
    {{/if}}
</article>
