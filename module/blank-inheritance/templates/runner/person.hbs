{{!--
    One person the GM might have to be.

    Ordered the way it is actually needed at the table: what they WANT first,
    because that is the field that decides what they do when the players go
    somewhere the script never anticipated. Topics second. Sample lines last,
    where the eye can find them without reading past them every time.
--}}
{{!--
    Folded by default, and the SUMMARY is the part that decides what this
    person does when the players go somewhere the script never anticipated:
    their name, their role, and what they want. Everything below — topics,
    refusals, sample lines — is looked up when they actually speak, which is
    why it is one click away rather than two screens of scroll.
--}}
<details class="bi-runner__person{{#if walkOn}} bi-runner__person--walkon{{/if}}">
    <summary class="bi-runner__person-head">
        <span class="bi-runner__person-name">{{displayName}}</span>
        {{#if role}}<span class="bi-runner__person-role">{{role}}</span>{{/if}}
        {{#if brief.wants}}<span class="bi-runner__wants">{{brief.wants}}</span>{{/if}}
    </summary>

    {{!-- Straight onto the stage the table is looking at. Most of a brief's
          cast have no Actor at all, which is exactly the case the summon
          panel cannot help with. --}}
    <button type="button" class="bi-runner__stage{{#if onStage}} bi-runner__stage--on{{/if}}"
        data-action="stagePerson" data-portrait-id="{{portraitId}}"
        data-tooltip="{{#if onStage}}{{localize 'BLANKINHERITANCE.Runner.OnStage'}}{{else}}{{localize 'BLANKINHERITANCE.Runner.PutOnStage'}}{{/if}}">
        <i class="fa-solid fa-masks-theater"></i> {{localize "BLANKINHERITANCE.Runner.PutOnStage"}}
    </button>

    {{#if brief.opensWith}}
    <ul class="bi-runner__topics">
        <li class="bi-runner__topic"><b>{{localize "BLANKINHERITANCE.Runner.Opens"}}</b> {{brief.opensWith}}</li>
    </ul>
    {{/if}}

    {{#if brief.willDiscuss.length}}
    <p class="bi-runner__section-title">{{localize "BLANKINHERITANCE.Runner.Will"}}</p>
    <ul class="bi-runner__topics">
        {{#each brief.willDiscuss}}
        <li class="bi-runner__topic"><b>{{topic}}</b>{{#if note}} — <i>{{note}}</i>{{/if}}</li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if brief.willNotDiscuss.length}}
    <p class="bi-runner__section-title">{{localize "BLANKINHERITANCE.Runner.WillNot"}}</p>
    <ul class="bi-runner__topics">
        {{#each brief.willNotDiscuss}}
        <li class="bi-runner__topic bi-runner__topic--refused"><b>{{topic}}</b>{{#if why}} — <i>{{why}}</i>{{/if}}</li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if brief.coercible.length}}
    <p class="bi-runner__section-title">{{localize "BLANKINHERITANCE.Runner.Coercible"}}</p>
    <ul class="bi-runner__topics">
        {{#each brief.coercible}}
        <li class="bi-runner__topic"><b>{{topic}}</b>{{#if how}} — <i>{{how}}</i>{{/if}}</li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if brief.voice.register}}<p class="bi-runner__note">{{brief.voice.register}}</p>{{/if}}

    {{#if brief.voice.samples.length}}
    <div class="bi-runner__samples">
        {{#each brief.voice.samples}}
        <p class="bi-runner__sample">{{this}}</p>
        {{/each}}
    </div>
    {{/if}}
</details>
