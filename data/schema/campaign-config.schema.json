{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-config.schema.json",
  "title": "Campaign Config",
  "description": "Core numeric/procedural rules: Frame economy, Time Economy, Contact Pool, False Contact. Singleton file: data/campaign/config.json. (Resonance, Bleed, Anchors and Suppression were cut 2026-09-20 and removed 2026-09-25.)",
  "type": "object",
  "required": ["id"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "config" },
    "cutSystemsNote": { "type": "string", "description": "Where the cut systems went (Resonance, Bleed, Anchors, Suppression, the ground roles; cut 2026-09-20)." },
    "frameEconomy": {
      "type": "object",
      "properties": {
        "rosterSize": { "type": "integer" },
        "hpAsCampaignResource": { "type": "string" },
        "damageStates": { "type": "array", "items": { "type": "string" } },
        "repair": {
          "type": "object",
          "properties": {
            "cost": { "type": "string" },
            "sharedPoolNote": { "type": "string" }
          }
        },
        "upgradePoints": {
          "type": "object",
          "description": "What a pilot's machine budget buys: capability, never levels (lockstep since 2026-09-20). See open-questions.json#frame-upgrade-economy.",
          "properties": {
            "model": { "type": "string" },
            "earnedFrom": { "type": "string" },
            "pool": { "type": "string" },
            "acquisition": { "type": "string" },
            "overInvestmentCost": { "type": "string" },
            "openQuestionRef": { "type": "string" }
          }
        },
        "repairCrew": {
          "type": "object",
          "description": "Each pilot's own standing NPC repair crew, whose relationship scales repair effectiveness.",
          "properties": {
            "confirmed": { "type": "string" },
            "goodStanding": { "type": "string" },
            "neglected": { "type": "string" },
            "whyItIsNotRedundantWithTechnicianDays": { "type": "string" },
            "openQuestionRef": { "type": "string" }
          }
        },
        "deployability": { "type": "string" },
        "permanentLoss": { "type": "string" }
      }
    },
    "timeEconomy": {
      "type": "object",
      "properties": {
        "discretionarySlicesPerDay": { "type": "integer" },
        "slicesRevisionNote": { "type": "string", "description": "Free-text history for when discretionarySlicesPerDay itself changes, so a stale number in a doc/comment doesn't outlive the data." },
        "mandatoryLoad": { "type": "string" },
        "designIntent": { "type": "string" },
        "restIsAlwaysAvailable": { "type": "string", "description": "Confirms resting is always a legal, encouraged use of a discretionary slice, independent of the options list below." },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "effect": { "type": "string" },
              "cost": { "type": "string" },
              "openQuestionRef": { "type": "string", "description": "id of an entry in data/campaign/open-questions.json, when part of this option is still undecided." }
            }
          }
        },
        "fatigue": {
          "type": "object",
          "description": "Working consecutive segments without resting; see design/ux-doctrine.md §3.",
          "properties": {
            "description": { "type": "string" },
            "check": { "type": ["string", "null"] },
            "dcEscalation": { "type": ["string", "null"] },
            "failureConsequence": { "type": "string" },
            "resetBy": { "type": "string" },
            "openQuestionRef": { "type": "string" }
          }
        }
      }
    },
    "contactPool": {
      "type": "object",
      "properties": {
        "designIntent": { "type": "string" },
        "activeFrom": { "type": "string" },
        "floor": {
          "type": "object",
          "properties": { "description": { "type": "string" }, "quietDays": { "type": "integer" } }
        },
        "rollProcedure": {
          "type": "object",
          "properties": {
            "startsDay": { "type": "string" },
            "die": { "type": "string" },
            "frequency": { "type": "string" },
            "triggerOn": { "type": "integer" },
            "targetDecreasePerQuietMorning": { "type": "integer" },
            "description": { "type": "string" }
          }
        },
        "ceiling": {
          "type": "object",
          "properties": { "description": { "type": "string" }, "quietMorningLimit": { "type": "integer" } }
        },
        "analysisDutyInteraction": { "type": "string" }
      }
    },
    "falseContact": {
      "type": "object",
      "properties": {
        "sharedCost": { "type": "string" },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "antagonistRef": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
